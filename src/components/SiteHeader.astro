---
interface NavItem { label: string; href: string; }
interface Props {
  title: string;
  tagline?: string;
  monogram?: string;
  nav?: NavItem[];
  /** Where the brand/logo links to. Defaults to the site root. */
  homeHref?: string;
}
const { title, tagline, monogram = "AO", nav = [], homeHref = "/" } = Astro.props;
import Monogram from "./Monogram.astro";
---

<header class="site-header">
  <a class="brand" href={homeHref}>
    <Monogram letters={monogram} size={56} />
    <div class="brand-text">
      <span class="brand-name">{title}</span>
      {tagline && <span class="brand-tagline">{tagline}</span>}
    </div>
  </a>
  {(nav.length > 0 || Astro.slots.has("nav-end")) && (
    <nav>
      {nav.length > 0 && (
        <ul>
          {nav.map(({ label, href }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      )}
      <slot name="nav-end" />
    </nav>
  )}
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px;
    max-width: 1080px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--text);
  }
  .brand:hover { text-decoration: none; }
  .brand-text { display: flex; flex-direction: column; line-height: 1.1; }
  .brand-name {
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.01em;
  }
  .brand-tagline {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.04em;
    margin-top: 2px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 12px 24px;
    /* On narrow screens, trailing slot content (e.g. a language switcher)
       wraps onto its own line under the nav links instead of overflowing. */
    flex-wrap: wrap;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    list-style: none;
  }
  nav a {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 500;
  }
  nav a:hover { color: var(--primary); text-decoration: none; }
</style>
