---
interface Props {
  title: string;
  date: string | Date;
  description?: string;
  href: string;
  locale?: string;
}
const { title, date, description, href, locale = "sv-SE" } = Astro.props;
const d = typeof date === "string" ? new Date(date) : date;
const dateLabel = d.toLocaleDateString(locale, {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<article class="news">
  <div class="news-date">{dateLabel}</div>
  <h3 class="news-title"><a href={href}>{title}</a></h3>
  {description && <p class="news-desc">{description}</p>}
  <a class="news-cta" href={href}>→ Läs mer</a>
</article>

<style>
  .news {
    padding: 20px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--primary) 13%, transparent);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .news-date {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .news-title {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.15;
  }
  .news-title a { color: var(--text); }
  .news-title a:hover { color: var(--primary); text-decoration: none; }
  .news-desc {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--muted);
    line-height: 1.55;
    max-width: 60ch;
  }
  .news-cta {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--primary);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
</style>
