---
interface Props {
  title: string;
  date: string | Date;
  venue: string;
  city?: string;
  ticketUrl?: string;
  status?: "upcoming" | "past" | "cancelled";
  locale?: string;
}
const {
  title,
  date,
  venue,
  city,
  ticketUrl,
  status = "upcoming",
  locale = "sv-SE",
} = Astro.props;

const d = typeof date === "string" ? new Date(date) : date;
const dateLabel = d.toLocaleDateString(locale, {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const isPast = status === "past" || d.getTime() < Date.now();
---

<article class={`gig ${isPast ? "is-past" : ""} status-${status}`}>
  <div class="gig-date">{dateLabel}</div>
  <h3 class="gig-title">{title}</h3>
  <div class="gig-where">
    <span>{venue}</span>{city && <span class="muted"> · {city}</span>}
  </div>
  {status === "cancelled" && <div class="gig-flag">Inställd</div>}
  {ticketUrl && status === "upcoming" && (
    <a class="gig-cta" href={ticketUrl}>→ Biljetter</a>
  )}
</article>

<style>
  .gig {
    border: 1px solid color-mix(in srgb, var(--primary) 13%, transparent);
    border-radius: var(--radius-card, 4px);
    padding: 20px 24px;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .gig.is-past { opacity: 0.65; }
  .gig-date {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
  }
  .gig-title {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.1;
    color: var(--text);
  }
  .gig-where {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text);
  }
  .gig-flag {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--primary);
    font-weight: 600;
    margin-top: 4px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .gig-cta {
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--primary);
    font-weight: 500;
    letter-spacing: 0.04em;
    margin-top: 6px;
  }
</style>
